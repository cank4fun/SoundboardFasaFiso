#include <winver.h>
#include "ResourceIds.h"

IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/SoundBoardFasaFiso.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG | @SOUNDBOARD_VERSION_FILE_FLAGS@
#else
    FILEFLAGS @SOUNDBOARD_VERSION_FILE_FLAGS@
#endif
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SoundBoardFasaFiso contributors\0"
            VALUE "FileDescription", "Portable Windows soundboard\0"
            VALUE "FileVersion", "@SOUNDBOARD_VERSION@\0"
            VALUE "InternalName", "SoundBoardFasaFiso\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 SoundBoardFasaFiso contributors\0"
            VALUE "OriginalFilename", "SoundBoardFasaFiso.exe\0"
            VALUE "ProductName", "SoundBoardFasaFiso\0"
            VALUE "ProductVersion", "@SOUNDBOARD_VERSION@\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
